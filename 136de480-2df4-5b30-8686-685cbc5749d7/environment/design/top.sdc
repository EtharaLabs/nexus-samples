set_units -time ns -capacitance pF
create_clock -name clk -period 0.32 -waveform {0 0.03} [get_ports clk]
create_generated_clock -name gclk -source [get_pins udiv0/CK] -divide_by 2 [get_pins udiv0/Q]
set_propagated_clock [all_clocks]
set_clock_transition 0.0456 [get_clocks clk]
set_input_transition 0.0452 [get_ports clk]
set_input_transition 0.039 [get_ports in0]
set_input_transition 0.0737 [get_ports in1]
set_input_transition 0.0165 [get_ports in2]
set_input_transition 0.0342 [get_ports in3]
set_input_transition 0.0987 [get_ports in4]
set_input_transition 0.0645 [get_ports en]
set_input_delay -clock clk -max 0.06 [get_ports in0]
set_input_delay -clock clk -min 0.0238 [get_ports in0]
set_input_delay -clock clk -max 0.0898 [get_ports in1]
set_input_delay -clock clk -min 0.0463 [get_ports in1]
set_input_delay -clock clk -max 0.101 [get_ports in2]
set_input_delay -clock clk -min 0.0526 [get_ports in2]
set_input_delay -clock clk -max 0.0258 [get_ports in3]
set_input_delay -clock clk -min 0.0169 [get_ports in3]
set_input_delay -clock clk -max 0.0881 [get_ports in4]
set_input_delay -clock clk -min 0.0515 [get_ports in4]
set_input_delay -clock clk -max 0.1094 [get_ports en]
set_input_delay -clock clk -min 0.0653 [get_ports en]
set_output_delay -clock clk -max 0.0824 [get_ports out0]
set_output_delay -clock clk -min -0.0087 [get_ports out0]
set_output_delay -clock clk -max 0.0461 [get_ports out1]
set_output_delay -clock clk -min -0.0025 [get_ports out1]
set_output_delay -clock clk -max 0.0419 [get_ports out2]
set_output_delay -clock clk -min -0.0017 [get_ports out2]
set_output_delay -clock clk -max 0.0462 [get_ports out3]
set_output_delay -clock clk -min 0.0096 [get_ports out3]
set_load 0.0086 [get_ports out0]
set_load 0.052 [get_ports out1]
set_load 0.0562 [get_ports out2]
set_load 0.0278 [get_ports out3]
set_multicycle_path 3 -setup -from [get_cells {r4 r7 r2}]
set_false_path -to [get_cells {r2 r6 r7}]
set_timing_derate -early -clock -cell_delay 0.92
set_timing_derate -late -clock -cell_delay 1.08
set_timing_derate -early -data -cell_delay 0.95
set_timing_derate -late -data -cell_delay 1.06
