#!/usr/bin/env python3
"""Deterministic exactly-once gap-session-window streaming engine.

CLI:  stream run <chunk> <out> <ckpt> [--resume] [--final]
"""
import json
import os
import sys


def _config():
    cfg = os.path.join(os.environ.get("KVD_HOME", "/app/data"), "config.json")
    with open(cfg) as fh:
        c = json.load(fh)
    return int(c["session_gap_ms"]), int(c["allowed_lateness_ms"]), int(c["checkpoint_interval"])


class Engine:
    def __init__(self, gap, lateness):
        self.gap = gap
        self.lateness = lateness
        self.W = None          # None == below every timestamp
        self.emit = 0
        self.dropped = 0
        # key -> list of sessions [start, end, count, sum, finalized(bool)]
        self.sessions = {}

    # ---- state persistence -------------------------------------------------
    def to_state(self):
        return {
            "version": 1,
            "W": self.W,
            "emit": self.emit,
            "dropped": self.dropped,
            "sessions": {k: [list(s) for s in v] for k, v in sorted(self.sessions.items()) if v},
        }

    def load_state(self, st):
        self.W = st["W"]
        self.emit = int(st["emit"])
        self.dropped = int(st["dropped"])
        self.sessions = {}
        for k, v in st["sessions"].items():
            self.sessions[k] = [[int(s[0]), int(s[1]), int(s[2]), int(s[3]), bool(s[4])] for s in v]

    # ---- emission ----------------------------------------------------------
    def _flush(self, recs, out):
        # recs: list of (key, start, end, typ_order, count, sum, type)
        recs.sort(key=lambda r: (r[0], r[1], r[2], r[3]))
        for key, start, end, _o, count, total, typ in recs:
            self.emit += 1
            out.write(json.dumps({"count": count, "emit": self.emit, "end": end, "key": key,
                                  "start": start, "sum": total, "type": typ},
                                 sort_keys=True) + "\n")

    @staticmethod
    def _rec(key, s, typ):
        return (key, s[0], s[1], 0 if typ == "RETRACT" else 1, s[2], s[3], typ)

    # ---- message handlers ---------------------------------------------------
    def on_event(self, key, ts, val, out):
        gap = self.gap
        if self.W is not None and self.W - ts > self.lateness:
            self.dropped += 1
            return
        lst = self.sessions.setdefault(key, [])
        matches = []
        rest = []
        for s in lst:
            if s[0] - gap <= ts <= s[1] + gap:
                matches.append(s)
            else:
                rest.append(s)
        recs = []
        merged = [ts, ts, 1, val, False]
        any_final = False
        for s in matches:
            if s[4]:
                any_final = True
                recs.append(self._rec(key, s, "RETRACT"))
            merged[0] = min(merged[0], s[0])
            merged[1] = max(merged[1], s[1])
            merged[2] += s[2]
            merged[3] += s[3]
        if any_final and self.W is not None and self.W > merged[1] + gap:
            merged[4] = True
            recs.append(self._rec(key, merged, "FINAL"))
        rest.append(merged)
        rest.sort(key=lambda s: (s[0], s[1]))
        self.sessions[key] = rest
        if recs:
            self._flush(recs, out)

    def on_watermark(self, ts, out):
        if self.W is None or ts > self.W:
            self.W = ts
        W = self.W
        gap = self.gap
        lat = self.lateness
        recs = []
        for key in list(self.sessions.keys()):
            keep = []
            for s in self.sessions[key]:
                if not s[4] and W > s[1] + gap:
                    s[4] = True
                    recs.append(self._rec(key, s, "FINAL"))
                if s[4] and W > s[1] + gap + lat:
                    continue  # garbage-collect
                keep.append(s)
            if keep:
                self.sessions[key] = keep
            else:
                del self.sessions[key]
        if recs:
            self._flush(recs, out)

    def finish(self, out):
        recs = []
        for key, lst in self.sessions.items():
            for s in lst:
                if not s[4]:
                    s[4] = True
                    recs.append(self._rec(key, s, "FINAL"))
        if recs:
            self._flush(recs, out)
        self.sessions = {}
        self.emit += 1
        out.write(json.dumps({"dropped_late": self.dropped, "emit": self.emit, "type": "EOF"},
                             sort_keys=True) + "\n")


def _atomic_write(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(data)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def run(chunk, out_path, ckpt_path, resume, final):
    gap, lateness, _interval = _config()
    eng = Engine(gap, lateness)
    if resume:
        with open(ckpt_path) as fh:
            eng.load_state(json.load(fh))
        out = open(out_path, "a")
    else:
        out = open(out_path, "w")
    try:
        with open(chunk) as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                msg = json.loads(line)
                t = msg.get("type")
                if t == "event":
                    eng.on_event(str(msg["key"]), int(msg["ts"]), int(msg["val"]), out)
                    out.flush()
                    sys.stdout.write("ACK %d\n" % int(msg["seq"]))
                    sys.stdout.flush()
                elif t == "watermark":
                    eng.on_watermark(int(msg["ts"]), out)
        if final:
            eng.finish(out)
        out.flush()
        os.fsync(out.fileno())
    finally:
        out.close()
    if not final:
        _atomic_write(ckpt_path, json.dumps(eng.to_state(), sort_keys=True))
    return 0


def main(argv):
    if len(argv) < 4 or argv[0] != "run":
        sys.stderr.write("usage: stream run <chunk> <out> <ckpt> [--resume] [--final]\n")
        return 2
    flags = argv[4:]
    for f in flags:
        if f not in ("--resume", "--final"):
            sys.stderr.write("unknown option: %s\n" % f)
            return 2
    return run(argv[1], argv[2], argv[3], "--resume" in flags, "--final" in flags)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
